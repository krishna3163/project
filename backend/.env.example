# ── Backend environment variables ──────────────────────
# Copy this to a .env file on your Render deployment or local

MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/dsatracker
REDIS_URL=redis://default:<password>@redis-cloud.com:12345

# MUST be at least 32 characters long, cryptographically random
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_32_PLUS_CHAR_RANDOM_STRING

EMAIL_USERNAME=krishna3163019@gmail.com
# Use a Gmail App Password here, not your main Gmail password.
EMAIL_PASSWORD=your_gmail_app_password

# Comma-separated allowed origins for CORS
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

FRONTEND_URL=https://your-app.vercel.app
